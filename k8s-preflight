#!/usr/bin/env bash
# k8s-preflight - read-only checks before a Kubernetes minor version upgrade.
# Maintained by Agency 42 (https://agency42.se). Licensed under Apache-2.0.
# Background: https://agency42.se/en/articles/kubernetes-1-34-end-of-support-pre-flight-checklist
set -uo pipefail

VERSION="0.1.0"
KUBECTL="${KUBECTL:-kubectl}"
TARGET=""
CONTEXT_ARGS=()
NO_COLOR="${NO_COLOR:-}"
CERT_WARN_DAYS=30
PASS=0; WARN=0; FAIL=0

usage() {
  cat <<USAGE
k8s-preflight $VERSION - read-only pre-upgrade checks for Kubernetes clusters

Usage: k8s-preflight [--target 1.35] [--context NAME] [--cert-days 30] [--no-color]

  --target X.Y     Minor version you plan to upgrade to (default: current server minor + 1)
  --context NAME   kubeconfig context to use
  --cert-days N    Warn when the API server certificate expires within N days (default 30)
  --no-color       Plain output (also honours NO_COLOR)
  -h, --help       Show this help

Exit codes: 0 = all checks passed, 1 = warnings, 2 = at least one failure.
The script only reads from the cluster. It never changes anything.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --target) TARGET="${2:-}"; shift 2 ;;
    --context) CONTEXT_ARGS=(--context "${2:-}"); shift 2 ;;
    --cert-days) CERT_WARN_DAYS="${2:-30}"; shift 2 ;;
    --no-color) NO_COLOR=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --version) echo "$VERSION"; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 2 ;;
  esac
done

if [[ -z "$NO_COLOR" && -t 1 ]]; then
  G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; B=$'\e[1m'; N=$'\e[0m'
else G=""; Y=""; R=""; B=""; N=""; fi

k() { "$KUBECTL" "${CONTEXT_ARGS[@]}" "$@"; }
pass() { PASS=$((PASS+1)); echo "  ${G}[PASS]${N} $*"; }
warn() { WARN=$((WARN+1)); echo "  ${Y}[WARN]${N} $*"; }
fail() { FAIL=$((FAIL+1)); echo "  ${R}[FAIL]${N} $*"; }
info() { echo "         $*"; }
section() { echo; echo "${B}== $* ==${N}"; }
minor() { sed -E 's/^v?([0-9]+)\.([0-9]+).*/\2/' <<<"$1"; }
major() { sed -E 's/^v?([0-9]+)\..*/\1/' <<<"$1"; }

command -v "$KUBECTL" >/dev/null 2>&1 || { echo "kubectl not found (set KUBECTL=...)" >&2; exit 2; }

echo "${B}k8s-preflight $VERSION${N} - read-only pre-upgrade checks"
echo "Context: $(k config current-context 2>/dev/null || echo unknown)"

# --- 1. Versions and skew -------------------------------------------------
section "1. Client/server version skew"
VJSON="$(k version -o json 2>/dev/null)"
CLIENT_V="$(grep -A12 '"clientVersion"' <<<"$VJSON" | grep -m1 '"gitVersion"' | sed -E 's/.*"gitVersion": *"([^"]+)".*/\1/')"
SERVER_V="$(grep -A12 '"serverVersion"' <<<"$VJSON" | grep -m1 '"gitVersion"' | sed -E 's/.*"gitVersion": *"([^"]+)".*/\1/')"
if [[ -z "$SERVER_V" ]]; then
  fail "Cannot reach the API server. Check your kubeconfig/context."; echo; exit 2
fi
SMIN="$(minor "$SERVER_V")"; CMIN="$(minor "$CLIENT_V")"
[[ -z "$TARGET" ]] && TARGET="$(major "$SERVER_V").$((SMIN+1))"
TMIN="$(minor "$TARGET")"
info "server $SERVER_V, kubectl $CLIENT_V, target $TARGET"
if (( TMIN - SMIN > 1 )); then
  fail "Target $TARGET skips minor versions. The control plane must move one minor at a time."
elif (( TMIN <= SMIN )); then
  warn "Target $TARGET is not newer than the server ($SERVER_V)."
else
  pass "Upgrade path $SERVER_V -> $TARGET is a single minor step."
fi
if (( CMIN - SMIN > 1 || SMIN - CMIN > 1 )); then
  warn "kubectl $CLIENT_V is more than one minor away from the server (supported skew is +/-1)."
else
  pass "kubectl is within +/-1 minor of the server."
fi

# --- 2. Nodes -------------------------------------------------------------
section "2. Nodes: kubelet skew, runtime, kernel"
NODES_RC=0
NODES="$(k get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.nodeInfo.kubeletVersion}{"\t"}{.status.nodeInfo.containerRuntimeVersion}{"\t"}{.status.nodeInfo.kernelVersion}{"\t"}{.status.nodeInfo.operatingSystem}{"\t"}{range .status.conditions[?(@.type=="Ready")]}{.status}{end}{"\n"}{end}' 2>/dev/null)" || NODES_RC=$?
if (( NODES_RC != 0 )); then
  warn "Could not list nodes (RBAC?)."
elif [[ -z "$NODES" ]]; then
  warn "The cluster has no registered nodes."
else
  NODE_ISSUES=0
  while IFS=$'\t' read -r name kubelet runtime kernel os ready; do
    [[ -z "$name" ]] && continue
    info "$name  kubelet=$kubelet  runtime=$runtime  kernel=$kernel  ready=$ready"
    km="$(minor "$kubelet")"
    if (( km > SMIN )); then fail "$name: kubelet $kubelet is newer than the API server."; NODE_ISSUES=1
    elif (( TMIN - km > 3 )); then fail "$name: kubelet $kubelet would be more than 3 minors behind $TARGET. Upgrade nodes first."; NODE_ISSUES=1
    elif (( SMIN - km > 0 )); then warn "$name: kubelet $kubelet lags the control plane (allowed, but finish the last upgrade)."; NODE_ISSUES=1
    fi
    [[ "$ready" != "True" ]] && { warn "$name is not Ready."; NODE_ISSUES=1; }
    if [[ "$runtime" == containerd://1.* ]]; then
      if (( TMIN >= 36 )); then fail "$name: $runtime. Kubernetes 1.35 is the last release supporting containerd 1.x."
      else warn "$name: $runtime. Plan containerd 2.x before going past 1.35."; fi
      NODE_ISSUES=1
    fi
    if [[ "$os" == "linux" ]]; then
      kmaj="${kernel%%.*}"; krest="${kernel#*.}"; kmin="${krest%%[!0-9]*}"
      if [[ "$kmaj" =~ ^[0-9]+$ && "$kmin" =~ ^[0-9]+$ ]] && (( kmaj < 5 || (kmaj == 5 && kmin < 8) )); then
        warn "$name: kernel $kernel is older than 5.8, so cgroup v2 is unlikely. A 1.35+ kubelet refuses cgroup v1 by default."; NODE_ISSUES=1
      fi
    fi
    if k get --raw "/api/v1/nodes/$name/proxy/metrics" 2>/dev/null | grep -q '^kubelet_cri_losing_support'; then
      warn "$name: kubelet reports kubelet_cri_losing_support (runtime support is ending)."; NODE_ISSUES=1
    fi
  done <<<"$NODES"
  (( NODE_ISSUES == 0 )) && pass "All nodes Ready, kubelets match the control plane, no runtime/kernel red flags."
  info "cgroup version is not visible through the API. On each node run: stat -fc %T /sys/fs/cgroup/  (want cgroup2fs)"
fi

# --- 3. Deprecated APIs ---------------------------------------------------
section "3. Deprecated API usage (apiserver_requested_deprecated_apis)"
METRICS="$(k get --raw /metrics 2>/dev/null)"
if [[ -z "$METRICS" ]]; then
  warn "Could not read /metrics (needs get on nonResourceURL /metrics)."
else
  DEP="$(grep '^apiserver_requested_deprecated_apis{' <<<"$METRICS")"
  if [[ -z "$DEP" ]]; then
    pass "No deprecated API calls recorded by this API server instance."
  else
    while read -r line; do
      grp="$(sed -nE 's/.*[{,]group="([^"]*)".*/\1/p' <<<"$line")"; ver="$(sed -nE 's/.*[{,]version="([^"]*)".*/\1/p' <<<"$line")"
      res="$(sed -nE 's/.*[{,]resource="([^"]*)".*/\1/p' <<<"$line")"; rem="$(sed -nE 's/.*[{,]removed_release="([^"]*)".*/\1/p' <<<"$line")"
      gv="${grp:+$grp/}$ver"
      if [[ -n "$rem" ]] && (( $(minor "$rem") <= TMIN )); then
        fail "$gv $res is removed in $rem and is still being called."
      elif [[ -n "$rem" ]]; then
        warn "$gv $res is deprecated (removal planned in $rem)."
      else
        warn "$gv $res is deprecated (no removal release set; not a blocker)."
      fi
    done <<<"$DEP"
  fi
  info "The metric covers only this API server instance since its last restart. Scan manifests/Helm releases with Pluto too."
fi

# --- 4. etcd --------------------------------------------------------------
section "4. etcd health (via API server health checks)"
ETCD="$(k get --raw '/readyz/etcd' 2>&1)"
if [[ "$ETCD" == "ok" ]]; then pass "API server reports etcd ready (/readyz/etcd)."
elif [[ "$ETCD" == *orbidden* ]]; then warn "Not allowed to read /readyz/etcd."
else fail "etcd readiness check failed: $ETCD"; fi
ETCDV="$(k -n kube-system get pods -l component=etcd -o jsonpath='{range .items[*]}{.spec.containers[0].image}{"\n"}{end}' 2>/dev/null | sort -u)"
if [[ -n "$ETCDV" ]]; then
  info "etcd image(s): $(tr '\n' ' ' <<<"$ETCDV")"
  grep -qE ':v?3\.5\.([0-9]|1[0-9]|2[0-5])(-|$)' <<<"$ETCDV" && warn "etcd 3.5 older than 3.5.26: move to 3.5.26+ before 3.6 (zombie member bug)."
else
  info "etcd not visible as a static pod (managed or external etcd)."
fi
info "Reminder: take an etcd snapshot AND test-restore it before the upgrade."

# --- 5. PodDisruptionBudgets ---------------------------------------------
section "5. PodDisruptionBudgets that would block drains"
PDB="$(k get pdb -A -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{"\t"}{.status.disruptionsAllowed}{"\t"}{.status.expectedPods}{"\n"}{end}' 2>/dev/null)"
BLOCK="$(awk -F'\t' '$1!="" && $2=="0" && $3!="0"' <<<"$PDB")"
if [[ -z "$PDB" ]]; then pass "No PodDisruptionBudgets found."
elif [[ -z "$BLOCK" ]]; then pass "All PDBs allow at least one disruption."
else
  while IFS=$'\t' read -r n a e; do fail "PDB $n allows 0 disruptions ($e pods). kubectl drain will hang."; done <<<"$BLOCK"
fi

# --- 6. Pending / unhealthy pods -----------------------------------------
section "6. Pending and failing pods"
PEND="$(k get pods -A --field-selector=status.phase=Pending -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{"\n"}{end}' 2>/dev/null)"
if [[ -z "$PEND" ]]; then pass "No Pending pods."
else
  warn "$(wc -l <<<"$PEND") Pending pod(s). Drained workloads may have nowhere to go:"
  head -10 <<<"$PEND" | sed 's/^/           /'
fi
CRASH="$(k get pods -A -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{"\t"}{.status.containerStatuses[*].state.waiting.reason}{"\n"}{end}' 2>/dev/null | grep -E 'CrashLoopBackOff|ImagePullBackOff|ErrImagePull' || true)"
if [[ -n "$CRASH" ]]; then
  warn "Pods in CrashLoop/ImagePull back-off (fix or note them before the window):"
  head -10 <<<"$CRASH" | sed 's/^/           /'
fi

# --- 7. Certificates ------------------------------------------------------
section "7. Certificate expiry hints"
SERVER_URL="$(k config view --minify -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null)"
HOSTPORT="$(sed -E 's#^https://##; s#/.*$##' <<<"$SERVER_URL")"
[[ "$HOSTPORT" != *:* ]] && HOSTPORT="$HOSTPORT:443"
if command -v openssl >/dev/null 2>&1 && [[ "$SERVER_URL" == https://* ]]; then
  END="$(echo | timeout 10 openssl s_client -connect "$HOSTPORT" -servername "${HOSTPORT%:*}" 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)"
  if [[ -n "$END" ]]; then
    DAYS=$(( ( $(date -d "$END" +%s) - $(date +%s) ) / 86400 ))
    if (( DAYS < 0 )); then fail "API server certificate expired ($END)."
    elif (( DAYS < CERT_WARN_DAYS )); then warn "API server certificate expires in $DAYS days ($END)."
    else pass "API server certificate valid for $DAYS more days ($END)."; fi
  else warn "Could not read the API server certificate from $HOSTPORT."; fi
else
  info "openssl not available or non-HTTPS endpoint; skipped."
fi
info "kubeadm clusters: run 'kubeadm certs check-expiration' on a control-plane node. 'kubeadm upgrade apply' renews certs by default."

# --- 8. Add-ons -----------------------------------------------------------
section "8. Add-ons worth a look"
if [[ -n "$(k get pods -A -l app.kubernetes.io/name=ingress-nginx -o name 2>/dev/null)" ]]; then
  warn "Ingress NGINX (community controller) found. It was retired in March 2026; plan Gateway API / Ingress2Gateway."
else pass "No community Ingress NGINX pods found."; fi
KPMODE="$(k -n kube-system get cm kube-proxy -o jsonpath='{.data.config\.conf}' 2>/dev/null | grep -E '^mode:' | awk '{print $2}' | tr -d '"')"
if [[ "$KPMODE" == "ipvs" ]]; then warn "kube-proxy runs in ipvs mode (deprecated in 1.35). Start testing nftables."
elif [[ -n "$KPMODE" ]]; then pass "kube-proxy mode: $KPMODE"
else info "kube-proxy mode not found in kube-system/kube-proxy ConfigMap (default iptables, or not kubeadm)."; fi

# --- Summary --------------------------------------------------------------
echo
echo "${B}Summary:${N} ${G}$PASS passed${N}, ${Y}$WARN warnings${N}, ${R}$FAIL failed${N}  (target $TARGET)"
echo "Full checklist: https://agency42.se/en/articles/kubernetes-1-34-end-of-support-pre-flight-checklist"
(( FAIL > 0 )) && exit 2
(( WARN > 0 )) && exit 1
exit 0
